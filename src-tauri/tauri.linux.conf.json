{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "robz-dpi",
  "bundle": {
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "resources": {
      "engine/WinDivert.dll": null,
      "engine/WinDivert64.sys": null,
      "engine/licenses/": null
    },
    "linux": {
      "deb": {
        "section": "net",
        "preRemoveScript": "linux/prerm.sh",
        "files": {
          "/usr/lib/robz-dpi/robzdpi-engine": "engine-bin/target/release/robzdpi-engine"
        },
        "depends": [
          "nftables",
          "systemd",
          "polkitd | policykit-1"
        ]
      },
      "rpm": {
        "preRemoveScript": "linux/prerm.sh",
        "files": {
          "/usr/lib/robz-dpi/robzdpi-engine": "engine-bin/target/release/robzdpi-engine"
        },
        "depends": [
          "nftables",
          "systemd",
          "polkit"
        ]
      },
      "appimage": {
        "files": {
          "/usr/lib/robz-dpi/robzdpi-engine": "engine-bin/target/release/robzdpi-engine"
        }
      }
    }
  }
}
