{
  "name": "robz-dpi",
  "productName": "Robz DPI",
  "version": "0.1.0",
  "private": true,
  "description": "Discord, Roblox ve seçtiğin siteler için basit, açık kaynak DPI aşma aracı.",
  "license": "MIT",
  "homepage": "https://github.com/kutsalkiremitci/robz-dpi",
  "repository": {
    "type": "git",
    "url": "https://github.com/kutsalkiremitci/robz-dpi.git"
  },
  "scripts": {
    "postinstall": "node scripts/vendor.js && node scripts/fetch-engine.mjs --optional",
    "engine": "node scripts/fetch-engine.mjs",
    "dev": "tauri dev",
